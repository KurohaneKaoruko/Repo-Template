root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,vue,svelte,json,jsonc,yml,yaml,html,css,scss,less}]
indent_size = 2

[*.{go,mod,sum}]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{diff,patch}]
trim_trailing_whitespace = false
